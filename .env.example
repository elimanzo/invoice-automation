# Every environment variable this system reads. Copy to `.env` and fill in as needed.
#
# The system runs with none of these set: it falls back to the fake provider, which
# replays recorded responses and needs no credentials.

# xAI API key. When set, the real Grok provider becomes the default (ADR-0001).
XAI_API_KEY=

# xAI API base URL. The API is OpenAI-compatible; override only to point elsewhere.
XAI_BASE_URL=https://api.x.ai/v1

# Reasoning model to use.
INVOICE_MODEL=grok-4

# Directory for the catalogue and registry databases.
INVOICE_DATA_DIR=.data
